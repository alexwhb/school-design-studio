# Stock photos (the Photos panel).
#
# Browsing and searching are served by Unsplash. Register a free application at
# https://unsplash.com/oauth/applications to get an Access Key, then copy this
# file to .env.local and fill it in. Restart the server afterwards — it is read
# at startup.
#
# Without a key the panel falls back to the sample images bundled in
# service/src/mock/materials/photos, and search is turned off with a message
# saying why. The key is only ever read server-side; it is not in the bundle.
UNSPLASH_ACCESS_KEY=

# The application name you registered, used in the utm_source of the
# attribution links Unsplash asks apps to show. Optional.
UNSPLASH_APP_NAME=design-studio

# Point the editor at the real service/ backend instead of answering the
# read-only /design/* lookups in-process. Needed to *save* designs.
# DESIGN_API_URL=http://localhost:7001
