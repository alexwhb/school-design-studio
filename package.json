{
  "name": "design-studio",
  "version": "1.0.0",
  "private": true,
  "author": "ShawnPhang",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "start": "npm run build && node serve.mjs",
    "serve": "node serve.mjs",
    "build": "cross-env NODE_ENV=production && vite build",
    "typecheck": "vue-tsc --noEmit",
    "prepared": "npm i && cd service && PUPPETEER_DOWNLOAD_BASE_URL=https://cdn.npmmirror.com/binaries/chrome-for-testing npm i",
    "v-build": "cross-env NODE_ENV=production && vite build",
    "v-build-hard": "cross-env NODE_ENV=production vue-tsc --noEmit && vite build",
    "fetch-fonts": "node tools/fetch-fonts.mjs",
    "dev:react": "cross-env NODE_ENV=development vite --config vite.react.config.ts",
    "build:react": "cross-env NODE_ENV=production vite build --config vite.react.config.ts",
    "dev:servers": "node tools/dev/servers.mjs",
    "test:parity": "playwright test --project=parity",
    "test:e2e:react": "playwright test --project=e2e",
    "bench": "node tools/bench/bench.mjs",
    "bench:prod": "node tools/bench/start-prod.mjs && cross-env VUE_URL=http://127.0.0.1:4874 REACT_URL=http://127.0.0.1:4873 node tools/bench/bench.mjs",
    "build:embed": "cross-env NODE_ENV=production vite build --config vite.embed.config.ts",
    "dev:embed-demo": "cross-env NODE_ENV=development vite --config vite.embed-demo.config.ts",
    "typecheck:react": "tsc --noEmit -p react/tsconfig.json"
  },
  "dependencies": {
    "@palxp/color-picker": "workspace:*",
    "@palxp/image-extraction": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@scena/guides": "^0.18.1",
    "axios": "^0.21.1",
    "core-js": "^3.6.5",
    "cropperjs": "^1.6.1",
    "dayjs": "^1.10.7",
    "element-plus": "^2.6.3",
    "fontfaceobserver": "^2.1.0",
    "html2canvas": "^1.0.0",
    "immer": "^10.0.4",
    "microdiff": "^1.4.0",
    "mitt": "^3.0.1",
    "moveable": "^0.26.0",
    "moveable-helper": "^0.4.0",
    "nanoid": "^3.1.23",
    "normalize.css": "^8.0.1",
    "pinia": "^2.1.7",
    "pptxgenjs": "^4.0.1",
    "psd.js": "^3.9.0",
    "qr-code-styling": "^1.6.0-rc.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "selecto": "^1.13.0",
    "throttle-debounce": "^3.0.1",
    "valtio": "^2.3.2",
    "vite-plugin-compression": "^0.5.1",
    "vue": "3.4.19",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.0.0-0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cropperjs": "^1.3.0",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sortablejs": "^1.15.9",
    "@types/throttle-debounce": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-alloy": "~4.1.0",
    "eslint-plugin-vue": "^7.12.1",
    "less": "^4.1.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "terser": "^5.28.1",
    "typescript": "^5.2.2",
    "unplugin-element-plus": "^0.7.1",
    "vite": "^5.1.4",
    "vue-tsc": "^1.8.27"
  },
  "workspaces": [
    "packages/*"
  ],
  "browserslist": [
    "Chrome >= 90"
  ],
  "website": "https://design.palxp.cn",
  "homepage": "https://xp.palxp.cn",
  "description": "A simple English-language design editor for schools: posters, flyers, newsletters and slides, with PowerPoint export.",
  "exports": {
    ".": {
      "types": "./dist-embed/index.d.ts",
      "import": "./dist-embed/design-studio.js"
    },
    "./style.css": "./dist-embed/design-studio.css",
    "./src": "./react/src/index.ts"
  },
  "files": [
    "dist-embed",
    "react/src",
    "public"
  ]
}
