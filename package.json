{
  "name": "design-studio",
  "version": "0.1.3",
  "private": true,
  "author": "ShawnPhang",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "cross-env NODE_ENV=production vite build",
    "start": "npm run build && node serve.mjs",
    "serve": "node serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "prepared": "npm i && cd service && PUPPETEER_DOWNLOAD_BASE_URL=https://cdn.npmmirror.com/binaries/chrome-for-testing npm i",
    "fetch-fonts": "node tools/fetch-fonts.mjs",
    "fetch-iconfont": "node tools/fetch-iconfont.mjs",
    "dev:servers": "node tools/dev/servers.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "bench": "node tools/bench/bench.mjs",
    "bench:prod": "node tools/bench/start-prod.mjs && cross-env APP_URL=http://127.0.0.1:4873 node tools/bench/bench.mjs",
    "build:embed": "cross-env NODE_ENV=production vite build --config vite.embed.config.ts && cross-env NODE_ENV=production vite build --config vite.compose.config.ts && node tools/build/emit-types.mjs && node tools/build/copy-content.mjs",
    "release:embed": "node tools/release-embed.mjs",
    "dev:embed-demo": "cross-env NODE_ENV=development vite --config vite.embed-demo.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@scena/guides": "^0.18.1",
    "axios": "^0.21.1",
    "core-js": "^3.6.5",
    "cropperjs": "^1.6.1",
    "dayjs": "^1.10.7",
    "element-plus": "^2.6.3",
    "fontfaceobserver": "^2.1.0",
    "html2canvas-pro": "^2.4.1",
    "immer": "^10.0.4",
    "microdiff": "^1.4.0",
    "mitt": "^3.0.1",
    "moveable": "^0.26.0",
    "moveable-helper": "^0.4.0",
    "nanoid": "^3.1.23",
    "normalize.css": "^8.0.1",
    "pptxgenjs": "^4.0.1",
    "psd.js": "^3.9.0",
    "qr-code-styling": "^1.6.0-rc.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "selecto": "^1.13.0",
    "sortablejs": "^1.14.0",
    "throttle-debounce": "^3.0.1",
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cropperjs": "^1.3.0",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sortablejs": "^1.15.9",
    "@types/throttle-debounce": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-alloy": "~4.1.0",
    "less": "^4.1.1",
    "terser": "^5.28.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    "Chrome >= 90"
  ],
  "website": "https://design.palxp.cn",
  "homepage": "https://xp.palxp.cn",
  "description": "A simple English-language design editor for schools: posters, flyers, newsletters and slides, with PDF and PowerPoint export.",
  "exports": {
    ".": {
      "types": "./dist-embed/index.d.ts",
      "import": "./dist-embed/design-studio.js"
    },
    "./style.css": "./dist-embed/design-studio.css",
    "./src": "./src/index.ts"
  },
  "files": [
    "dist-embed",
    "src",
    "public"
  ]
}
